{
  "name": "claude-wsl-chrome-bridge",
  "version": "1.0.1",
  "description": "Bridge to enable Claude Code in WSL to communicate with Claude in Chrome on Windows",
  "type": "module",
  "scripts": {
    "build": "npm run build:protocol && npm run build:wsl && npm run build:native-host",
    "build:protocol": "tsc -p tsconfig.json",
    "build:wsl": "esbuild src/wsl-relay.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/wsl-relay.js",
    "build:native-host": "esbuild src/native-host.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/native-host.js",
    "build:installer": "node scripts/build-installer.js",
    "build:test": "tsc -p tsconfig.test.json",
    "release": "npm run build && npm run build:installer",
    "test": "npm run build:protocol && npm run build:test && node --test test/*.test.js",
    "test:connectivity": "node test/test-connectivity.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "wsl",
    "chrome",
    "native-messaging",
    "bridge"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
